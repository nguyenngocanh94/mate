== Tracker.Run ready --json
name: bd
args: ["init" "--prefix" "shop" "--skip-agents" "--skip-hooks" "--non-interactive"]
dir:  {{WORKSPACE}}/.mate/projects/shop
env:  BEADS_DIR={{WORKSPACE}}/.mate/projects/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

name: bd
args: ["ready" "--json"]
dir:  {{WORKSPACE}}/.mate/projects/shop
env:  BEADS_DIR={{WORKSPACE}}/.mate/projects/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

name: bd
args: ["export"]
dir:  {{WORKSPACE}}/.mate/projects/shop
env:  BEADS_DIR={{WORKSPACE}}/.mate/projects/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

