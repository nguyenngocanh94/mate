{
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/mate' hook mate-session",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/mate' hook mate-stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/usr/local/bin/mate' hook mate-prompt",
            "type": "command"
          }
        ]
      }
    ]
  }
}
