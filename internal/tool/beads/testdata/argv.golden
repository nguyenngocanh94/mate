== Command.Run ready --json
name: bd
args: ["init" "--prefix" "shop" "--skip-agents" "--skip-hooks" "--non-interactive"]
dir:  {{WORKSPACE}}/shop
env:  BEADS_DB=
env:  BD_DB=
env:  BEADS_DOLT_SERVER_HOST=
env:  BEADS_DOLT_SERVER_PORT=
env:  BEADS_DOLT_SERVER_SOCKET=
env:  BEADS_DOLT_MODE=
env:  BEADS_DOLT_DATABASE=
env:  BEADS_DATABASE=
env:  BEADS_DIR={{WORKSPACE}}/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

name: bd
args: ["ready" "--json"]
dir:  {{WORKSPACE}}/shop
env:  BEADS_DB=
env:  BD_DB=
env:  BEADS_DOLT_SERVER_HOST=
env:  BEADS_DOLT_SERVER_PORT=
env:  BEADS_DOLT_SERVER_SOCKET=
env:  BEADS_DOLT_MODE=
env:  BEADS_DOLT_DATABASE=
env:  BEADS_DATABASE=
env:  BEADS_DIR={{WORKSPACE}}/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

name: bd
args: ["export"]
dir:  {{WORKSPACE}}/shop
env:  BEADS_DB=
env:  BD_DB=
env:  BEADS_DOLT_SERVER_HOST=
env:  BEADS_DOLT_SERVER_PORT=
env:  BEADS_DOLT_SERVER_SOCKET=
env:  BEADS_DOLT_MODE=
env:  BEADS_DOLT_DATABASE=
env:  BEADS_DATABASE=
env:  BEADS_DIR={{WORKSPACE}}/shop/.beads
env:  BD_NON_INTERACTIVE=1
env:  BV_NO_UPDATE_CHECK=1
env:  BV_NO_GITIGNORE=1

